# Edge Functions (Supabase) uchun muhit oʻzgaruvchilari.
# HAQIQIY qiymatlarni bu yerga YOZMANG — ular Supabase secret sifatida saqlanadi:
#   supabase secrets set KEY=value --project-ref <ref>

# Supabase (SUPABASE_URL va SUPABASE_ANON_KEY funksiyalarga avtomatik beriladi)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (hujjatlar ombori, S3-mos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# Google Gemini (AI yordamchi)
GEMINI_API_KEY=

# Telegram bot
TG_BOT_TOKEN=
TG_WEBHOOK_SECRET=
TG_ACCESS_CODE=
TG_ADMIN_PHONES=
